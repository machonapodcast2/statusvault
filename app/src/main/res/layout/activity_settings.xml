<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-save new statuses"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0.7"
                android:text="Saves every status you have viewed in WhatsApp, in the background (checked about every 15 minutes) and whenever you open StatusVault." />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App lock (PIN)"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unlock with fingerprint"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/rowLinkWa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Re-link WhatsApp status folder"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/rowLinkBiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Re-link WhatsApp Business status folder"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.7"
                android:lineSpacingExtra="3dp"
                android:text="@string/about" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
